{
  "id": "app.cashzy.twa",
  "name": "Cashzy - Gerenciamento Financeiro",
  "short_name": "Cashzy",
  "description": "Gerenciamento financeiro inteligente para suas campanhas e despesas",
  "categories": ["finance", "business"],
  "lang": "pt-BR",
  "dir": "ltr",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1a1a1a",
  "theme_color": "#581c87",
  "prefer_related_applications": true,
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "icons": [
    {
      "src": "/logologin.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logologin.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=1080",
      "sizes": "1080x720",
      "type": "image/jpeg",
      "label": "Tela inicial do Cashzy"
    }
  ],
  "shortcuts": [
    {
      "name": "Nova Campanha",
      "url": "/?action=new-campaign",
      "description": "Criar nova campanha"
    },
    {
      "name": "Nova Despesa",
      "url": "/?action=new-expense",
      "description": "Adicionar nova despesa"
    }
  ],
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "text/csv": [".csv"]
      },
      "icons": [
        {
          "src": "/logologin.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "handle_links": {
    "handles": [
      {
        "accept": [
          {
            "protocol": "web+cashzy",
            "pattern": "/*"
          }
        ]
      }
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+cashzy",
      "url": "/%s"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipts",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  },
  "widgets": [
    {
      "name": "Resumo Financeiro",
      "tag": "financial-summary",
      "description": "Mostra um resumo das suas finanças",
      "ms_ac_template": "widget-template.json",
      "data": {
        "interval": 300,
        "url": "/widget-data"
      }
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.cashzy.twa",
      "id": "app.cashzy.twa"
    }
  ],
  "android_package_name": "app.cashzy.twa",
  "play_store_url": "https://play.google.com/store/apps/details?id=app.cashzy.twa",
  "chrome_status_bar": "translucent",
  "note_taking": {
    "new_note_url": "/new-note",
    "supports_file": true,
    "supports_text": true
  }
}